NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
TRUST_PROXY=false

# PostgreSQL (local en desarrollo; Supabase Session pooler en producción)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=securevault
DB_USER=securevault_app
DB_PASSWORD=
# Producción: pegar el certificado CA de Supabase (PEM) para verificar TLS
DB_SSL_CA=
DB_SSL=false

SESSION_SECRET=
ENCRYPTION_KEY_BASE64=
KEY_VERSION=1

# Correo opcional por API HTTPS de Brevo. Sin clave: en desarrollo el enlace se muestra en consola;
# en producción el token se genera pero no se envía (limitación documentada).
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=SecureVault
